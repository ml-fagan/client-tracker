# Azure app-only credentials — SAME app registration as the production widget.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Secret used to derive each project's permanent client link token.
# CRITICAL: must be a fixed random string, and MUST match the LINK_SECRET set in
# the production-widget project (so the copy-link column there produces links
# this app can resolve). If you ever change it, every client link breaks.
LINK_SECRET=

# The handover app — lets clients see jobs Duncan scheduled on the board that
# haven't reached the spreadsheet. JOB_API_SECRET must match the value set in
# production-widget and decorhandover. Without these, the tracker simply shows
# what the spreadsheet knows, exactly as before.
HANDOVER_APP_URL=https://decorhandover.lyphex.com
JOB_API_SECRET=must-match-the-other-apps
